<mxfile host="app.diagrams.net" modified="2026-07-05T09:08:00.000Z" agent="ChatGPT" version="25.0.3">
  <diagram id="dd35f39399504571967f" name="C4 Target Context">
    <mxGraphModel dx="1900" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1"
      connect="1" arrows="1" fold="1" page="1" pageScale="1"
      pageWidth="1900" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="C4 System Context — целевая архитектура «Медикаменте»" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Privacy by Design: защита по умолчанию, минимизация данных, централизованная авторизация, тегирование, аудит, Data Lineage и безопасная аналитика." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1450" height="40" as="geometry"/></mxCell><mxCell id="patient" value="&lt;b&gt;Пациент&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;span style='font-size:11px'&gt;Записывается на приём, оплачивает услуги, просматривает только свои документы и результаты&lt;/span&gt;" style="html=1;fontSize=12;dashed=0;whiteSpace=wrap;fillColor=#08427b;strokeColor=#052e56;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;resizable=0;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="220" height="190" as="geometry"/></mxCell><mxCell id="employee" value="&lt;b&gt;Сотрудник компании&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;span style='font-size:11px'&gt;Ресепшен, врач, кассир, бухгалтер, склад&lt;/span&gt;" style="html=1;fontSize=12;dashed=0;whiteSpace=wrap;fillColor=#08427b;strokeColor=#052e56;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;resizable=0;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="220" height="190" as="geometry"/></mxCell><mxCell id="analyst" value="&lt;b&gt;Аналитик&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;span style='font-size:11px'&gt;Использует обезличенные наборы для BI, ML и AI&lt;/span&gt;" style="html=1;fontSize=12;dashed=0;whiteSpace=wrap;fillColor=#08427b;strokeColor=#052e56;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;resizable=0;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="220" height="190" as="geometry"/></mxCell><mxCell id="security" value="&lt;b&gt;Специалист ИБ / аудитор&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;span style='font-size:11px'&gt;Контролирует события, политики доступа и инциденты&lt;/span&gt;" style="html=1;fontSize=12;dashed=0;whiteSpace=wrap;fillColor=#08427b;strokeColor=#052e56;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;resizable=0;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="220" height="190" as="geometry"/></mxCell><mxCell id="boundary" value="МЕДИКАМЕНТЕ — целевой цифровой контур" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#555555;strokeWidth=2;fontSize=14;verticalAlign=bottom;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="1190" height="1030" as="geometry"/></mxCell><mxCell id="client" value="&lt;b&gt;Клиентский портал&lt;br&gt;и мобильное приложение&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;span style='font-size:11px'&gt;Самостоятельная запись, оплата, документы, анализы и уведомления&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="350" y="180" width="260" height="140" as="geometry"/></mxCell><mxCell id="employee_portal" value="&lt;b&gt;Портал сотрудников&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;span style='font-size:11px'&gt;Единый интерфейс ресепшена, врачей, кассиров, бухгалтерии и склада&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="350" y="390" width="260" height="140" as="geometry"/></mxCell><mxCell id="core" value="&lt;b&gt;Медицинская платформа&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;span style='font-size:11px'&gt;Реестр пациентов, запись, электронная медкарта, договоры, платежи и уведомления&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="700" y="270" width="300" height="170" as="geometry"/></mxCell><mxCell id="integration" value="&lt;b&gt;Интеграционная платформа&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;span style='font-size:11px'&gt;API Gateway, адаптеры, mTLS/OAuth2, идемпотентность, schema validation и retries&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#2f6ea6;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1070" y="270" width="300" height="170" as="geometry"/></mxCell><mxCell id="privacy" value="&lt;b&gt;Privacy &amp; Security Platform&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;span style='font-size:11px'&gt;IAM/MFA, RBAC/ABAC, consent &amp; purpose, tagging, KMS, DLP, retention, Audit/SIEM&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#2f6ea6;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="700" y="520" width="300" height="190" as="geometry"/></mxCell><mxCell id="analytics" value="&lt;b&gt;Data &amp; Analytics Platform&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;span style='font-size:11px'&gt;Controlled Ingestion → Raw → Protected → Trusted; обезличивание, каталог, Data Lineage, BI/ML/AI&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#2f6ea6;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1070" y="520" width="300" height="190" as="geometry"/></mxCell><mxCell id="backoffice" value="&lt;b&gt;Back-office 1С&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;span style='font-size:11px'&gt;Бухгалтерия, кадровый учёт, зарплата, налоги и ТМЦ; доступ только через контролируемые интеграции&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="700" y="820" width="300" height="150" as="geometry"/></mxCell><mxCell id="ops" value="&lt;b&gt;Платформа эксплуатации&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;span style='font-size:11px'&gt;Kubernetes, observability, backup/restore, CI/CD и автоматические privacy-проверки&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#2f6ea6;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1070" y="820" width="300" height="150" as="geometry"/></mxCell><mxCell id="privacy_note" value="&lt;b&gt;Privacy by Design применяется сквозным образом&lt;/b&gt;&lt;br&gt;• защита и закрытый доступ по умолчанию;&lt;br&gt;• минимальные API-контракты;&lt;br&gt;• шифрование при хранении и передаче;&lt;br&gt;• теги CONFIDENTIAL / RESTRICTED;&lt;br&gt;• аудит чтения, изменения, экспорта и удаления;&lt;br&gt;• автоматические проверки в CI/CD;&lt;br&gt;• отдельный аналитический контур без прямого доступа к операционным ПДн." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="350" y="820" width="280" height="250" as="geometry"/></mxCell><mxCell id="lab" value="&lt;b&gt;Медицинская лаборатория&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;span style='font-size:11px'&gt;Принимает псевдонимизированные назначения и возвращает результаты&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1550" y="180" width="260" height="140" as="geometry"/></mxCell><mxCell id="payment" value="&lt;b&gt;Платёжный провайдер&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;span style='font-size:11px'&gt;Проводит оплату без хранения карточных данных в системах компании&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1550" y="370" width="260" height="140" as="geometry"/></mxCell><mxCell id="ofd" value="&lt;b&gt;ОФД / ККМ&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;span style='font-size:11px'&gt;Фискализация и формирование чеков&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1550" y="560" width="260" height="120" as="geometry"/></mxCell><mxCell id="bank_tax" value="&lt;b&gt;Банк, ФНС и СФР&lt;/b&gt;&lt;br&gt;[External Systems]&lt;br&gt;&lt;span style='font-size:11px'&gt;Выплаты, налоговая и кадровая отчётность&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1550" y="740" width="260" height="130" as="geometry"/></mxCell><mxCell id="channels" value="&lt;b&gt;Каналы уведомлений&lt;/b&gt;&lt;br&gt;[External Systems]&lt;br&gt;&lt;span style='font-size:11px'&gt;Push, SMS, email и голосовой робот; получают минимальный набор данных&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1550" y="930" width="260" height="140" as="geometry"/></mxCell><mxCell id="e1" value="Использует&lt;br&gt;[OIDC/MFA][TLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="patient" target="client"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="Работает через единый портал&lt;br&gt;[MFA][RBAC/ABAC]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="employee" target="employee_portal"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="Использует только Trusted Zone&lt;br&gt;[ANONYMIZED][PURPOSE.ANALYTICS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="analyst" target="analytics"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="Управляет политиками и расследует события" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="security" target="privacy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="REST/API&lt;br&gt;Только собственные данные" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="REST/API&lt;br&gt;Доступ по роли, филиалу и цели" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="employee_portal" target="core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="Проверяет доступ, согласия, теги и сроки хранения" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="core" target="privacy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="Аутентификация и управление согласиями" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="client" target="privacy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="Аутентификация, MFA и policy enforcement" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="employee_portal" target="privacy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="Передаёт минимальные доменные данные" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="core" target="integration"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="Controlled Ingestion&lt;br&gt;Потоки с lineage и тегами" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="core" target="analytics"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="Передаёт классификации, политики и правила обезличивания" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="privacy" target="analytics"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="Контролируемый обмен с 1С&lt;br&gt;[mTLS][idempotency]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="integration" target="backoffice"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="Политики секретов, аудита и retention" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="privacy" target="ops"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="Развёртывание, мониторинг, backup/restore" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="ops" target="core"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="Развёртывание и observability" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="ops" target="integration"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="Псевдонимизированные назначения и результаты&lt;br&gt;[mTLS][OAuth2]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="integration" target="lab"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="Оплата и callbacks&lt;br&gt;[NO CARD DATA][signed webhook]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="integration" target="payment"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="Фискальные операции&lt;br&gt;[mTLS][schema validation]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="integration" target="ofd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="Выплаты и отчётность&lt;br&gt;[signed documents]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="integration" target="bank_tax"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="Минимальные уведомительные данные&lt;br&gt;[DLP][masking]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="integration" target="channels"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
