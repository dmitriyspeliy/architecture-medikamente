  <diagram id="b93feedad1e44567bffe" name="03 Laboratory Secured">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1"
      connect="1" arrows="1" fold="1" page="1" pageScale="1"
      pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="DFD Secured: интеграция с лабораторией" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Целевой поток: API-интеграция, псевдонимизация пациента, минимальный контракт, mTLS/OAuth 2.0, проверка принадлежности и полный аудит." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1380" height="40" as="geometry"/></mxCell><mxCell id="doctor" value="Медицинский специалист&lt;br&gt;&lt;span style='font-size:12px'&gt;внутренний пользователь&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="220" height="90" as="geometry"/></mxCell><mxCell id="patient" value="Пациент&lt;br&gt;&lt;span style='font-size:12px'&gt;внешняя сущность&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="170" height="90" as="geometry"/></mxCell><mxCell id="lab" value="Лаборатория&lt;br&gt;&lt;span style='font-size:12px'&gt;внешняя система&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1450" y="300" width="190" height="100" as="geometry"/></mxCell><mxCell id="p1" value="3.1&lt;br&gt;Создание назначения&lt;br&gt;на анализы" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="230" width="180" height="180" as="geometry"/></mxCell><mxCell id="p2" value="3.2&lt;br&gt;Псевдонимизация&lt;br&gt;и подготовка запроса" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="220" width="190" height="190" as="geometry"/></mxCell><mxCell id="p3" value="3.3&lt;br&gt;API Gateway / Integration&lt;br&gt;Service" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="220" width="190" height="190" as="geometry"/></mxCell><mxCell id="p4" value="3.4&lt;br&gt;Приём, валидация&lt;br&gt;и связывание результата" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1270" y="520" width="200" height="200" as="geometry"/></mxCell><mxCell id="boundary" value="Контур медицинской информационной системы" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;strokeWidth=2;fontSize=13;verticalAlign=bottom;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="280" y="560" width="930" height="310" as="geometry"/></mxCell><mxCell id="d1" value="D1 Электронная медкарта&lt;br&gt;&lt;span style='font-size:11px'&gt;назначения и результаты&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="640" width="210" height="90" as="geometry"/></mxCell><mxCell id="d2" value="D2 Token Vault&lt;br&gt;&lt;span style='font-size:11px'&gt;patient_id ↔ lab_subject_id&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="640" width="190" height="90" as="geometry"/></mxCell><mxCell id="d3" value="D3 Integration Registry&lt;br&gt;&lt;span style='font-size:11px'&gt;request_id, status, retry&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="830" y="640" width="190" height="90" as="geometry"/></mxCell><mxCell id="d4" value="D4 Audit Log / SIEM&lt;br&gt;&lt;span style='font-size:11px'&gt;SEND/RECEIVE/DENY/ERROR&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="640" width="190" height="90" as="geometry"/></mxCell><mxCell id="controls" value="&lt;b&gt;Обязательные меры&lt;/b&gt;&lt;br&gt;• лаборатория не получает внутренний patient_id;&lt;br&gt;• минимальный API-контракт без лишних ПДн;&lt;br&gt;• mTLS + OAuth 2.0 Client Credentials;&lt;br&gt;• allow-list методов и полей;&lt;br&gt;• проверка схемы и цифровой подписи ответа;&lt;br&gt;• idempotency-key, retry и контроль дублей;&lt;br&gt;• rate limiting и защита от перебора идентификаторов;&lt;br&gt;• quarantine для некорректных результатов;&lt;br&gt;• шифрование и аудит всех операций." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="320" height="250" as="geometry"/></mxCell><mxCell id="e1" value="OIDC + MFA&lt;br&gt;[ABAC][TLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="doctor" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="Контекст пациента и согласие&lt;br&gt;[CONFIDENTIAL][PURPOSE.TREATMENT]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="patient" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="[RESTRICTED][SENSITIVE.HEALTH]&lt;br&gt;Назначение: анализ, дата, врач&lt;br&gt;[FIELD ENCRYPTION]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="order_id + минимальный набор данных&lt;br&gt;[DATA MINIMIZATION]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="Создание lab_subject_id&lt;br&gt;[TOKENIZATION][ENCRYPT]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="lab_subject_id, order_id, test_code,&lt;br&gt;биоматериал, дата рождения при необходимости&lt;br&gt;[NO INTERNAL PATIENT_ID]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="[RESTRICTED]&lt;br&gt;POST /lab-orders&lt;br&gt;[mTLS][OAuth2][SCHEMA VALIDATION][RATE LIMIT]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="lab"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="request_id, idempotency_key,&lt;br&gt;status, attempts, timestamps" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="[RESTRICTED]&lt;br&gt;Результат анализа + lab_subject_id&lt;br&gt;[mTLS][SIGNED RESPONSE]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lab" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="Разрешение lab_subject_id → patient_id&lt;br&gt;[SERVICE ACCOUNT ONLY]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="Обновление статуса запроса&lt;br&gt;[RECEIVED / VALIDATED / REJECTED]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="[RESTRICTED][SENSITIVE.HEALTH.LAB_RESULT]&lt;br&gt;Результат + связь с назначением&lt;br&gt;[ENCRYPT][VERSIONING][AUDIT.WRITE]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="Результат только назначившему/лечащему врачу&lt;br&gt;[ABAC][AUDIT.READ]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="doctor"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="Только собственный подтверждённый результат&lt;br&gt;[PATIENT_ID CHECK][TLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="patient"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1180" y="800"/><mxPoint x="130" y="800"/></Array></mxGeometry></mxCell><mxCell id="e15" value="SEND_ORDER / AUTH_DENY / RETRY&lt;br&gt;request_id, client_id, result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="RECEIVE_RESULT / VALIDATION_ERROR / LINK_RESULT&lt;br&gt;request_id, object_id, checksum" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
