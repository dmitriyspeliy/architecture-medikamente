      pageWidth="1850" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="DFD Secured: кадровый учёт, зарплата и налоги" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Целевой поток: разделение кадровых и расчётных данных, минимальные роли, шифрование полей, контролируемые интеграции с банком и ФНС, полный аудит." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1400" height="40" as="geometry"/></mxCell><mxCell id="employee" value="Сотрудник&lt;br&gt;&lt;span style='font-size:12px'&gt;внешняя сущность&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="180" height="90" as="geometry"/></mxCell><mxCell id="hr" value="Кадровый специалист&lt;br&gt;&lt;span style='font-size:12px'&gt;внутренний пользователь&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="210" height="90" as="geometry"/></mxCell><mxCell id="accountant" value="Бухгалтер&lt;br&gt;&lt;span style='font-size:12px'&gt;внутренний пользователь&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1460" y="640" width="190" height="90" as="geometry"/></mxCell><mxCell id="bank" value="Банк&lt;br&gt;&lt;span style='font-size:12px'&gt;внешняя система&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1460" y="220" width="180" height="90" as="geometry"/></mxCell><mxCell id="tax" value="ФНС / СФР&lt;br&gt;&lt;span style='font-size:12px'&gt;внешние системы&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1460" y="420" width="190" height="90" as="geometry"/></mxCell><mxCell id="p1" value="6.1&lt;br&gt;Регистрация сотрудника&lt;br&gt;и кадровых документов" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="240" width="190" height="190" as="geometry"/></mxCell><mxCell id="p2" value="6.2&lt;br&gt;Расчёт заработной платы,&lt;br&gt;налогов и удержаний" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="670" y="230" width="200" height="200" as="geometry"/></mxCell><mxCell id="p3" value="6.3&lt;br&gt;Формирование выплат&lt;br&gt;и обязательной отчётности" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1010" y="230" width="200" height="200" as="geometry"/></mxCell><mxCell id="p4" value="6.4&lt;br&gt;Сверка и обработка&lt;br&gt;исключений" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1280" y="560" width="190" height="190" as="geometry"/></mxCell><mxCell id="boundary" value="Контур HR и расчёта заработной платы" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;strokeWidth=2;fontSize=13;verticalAlign=bottom;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="270" y="590" width="950" height="310" as="geometry"/></mxCell><mxCell id="d1" value="D1 HR Registry&lt;br&gt;&lt;span style='font-size:11px'&gt;кадровая карточка и договоры&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="670" width="200" height="90" as="geometry"/></mxCell><mxCell id="d2" value="D2 Payroll DB&lt;br&gt;&lt;span style='font-size:11px'&gt;оклад, начисления, удержания&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="670" width="200" height="90" as="geometry"/></mxCell><mxCell id="d3" value="D3 Secure Document Storage&lt;br&gt;&lt;span style='font-size:11px'&gt;сканы, версии, подписи&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="670" width="220" height="90" as="geometry"/></mxCell><mxCell id="d4" value="D4 Audit Log / SIEM&lt;br&gt;&lt;span style='font-size:11px'&gt;READ/WRITE/EXPORT/CHANGE&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="670" width="200" height="90" as="geometry"/></mxCell><mxCell id="one_c" value="1С:Бухгалтерия предприятия&lt;br&gt;&lt;span style='font-size:11px'&gt;интеграционный контур&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1270" y="820" width="230" height="100" as="geometry"/></mxCell><mxCell id="controls" value="&lt;b&gt;Обязательные меры&lt;/b&gt;&lt;br&gt;• RBAC: HR, PAYROLL_ACCOUNTANT, AUDITOR;&lt;br&gt;• кадровые данные отделены от расчётных;&lt;br&gt;• шифрование паспортных, банковских и зарплатных полей;&lt;br&gt;• MFA и запрет общих учётных записей;&lt;br&gt;• маскирование зарплаты и реквизитов вне полномочий;&lt;br&gt;• электронная подпись и версионирование документов;&lt;br&gt;• mTLS/OAuth 2.0 для внешних интеграций;&lt;br&gt;• аудит чтения, изменения, выгрузки и корректировок;&lt;br&gt;• retention и контролируемое удаление." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="350" height="260" as="geometry"/></mxCell><mxCell id="e1" value="[RESTRICTED]&lt;br&gt;Паспортные данные, адрес, договор,&lt;br&gt;банковские реквизиты и заявления&lt;br&gt;[TLS][DATA MINIMIZATION]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="employee" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="Создание и изменение кадровой карточки&lt;br&gt;[RBAC:HR][MFA]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="hr" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="[RESTRICTED][SENSITIVE.HR.EMPLOYEE]&lt;br&gt;employee_id, должность, договор, статус&lt;br&gt;[FIELD ENCRYPTION][AUDIT.WRITE]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="Договоры, заявления и сканы&lt;br&gt;[ENCRYPT][VERSIONING][SIGNATURE][RETENTION]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="employee_id, должность, график,&lt;br&gt;оклад и кадровый статус&lt;br&gt;[RBAC:PAYROLL_ACCOUNTANT]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="Табель, отпуск, больничный,&lt;br&gt;премия и основания&lt;br&gt;[SEPARATION OF DUTIES]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="hr" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="[RESTRICTED][SENSITIVE.HR.PAYROLL]&lt;br&gt;Начисления, удержания, налоги&lt;br&gt;[FIELD ENCRYPTION][AUDIT.WRITE]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="Реестр выплат и отчётность&lt;br&gt;[APPROVAL][CHECKSUM]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="[RESTRICTED]&lt;br&gt;employee_payment_token, сумма, назначение&lt;br&gt;[mTLS][OAuth2][SIGNED REQUEST][IDEMPOTENCY]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="bank"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="Статус выплаты и bank_operation_id&lt;br&gt;[SIGNED RESPONSE][REPLAY PROTECTION]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bank" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="[RESTRICTED]&lt;br&gt;Регламентированная отчётность&lt;br&gt;[mTLS][SIGNED DOCUMENT][SCHEMA VALIDATION]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="tax"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="Квитанция, статус приёма, ошибки" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tax" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="Результаты выплат и сдачи отчётности&lt;br&gt;[ERROR / REJECTED / ACCEPTED]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="Проводки и расчётные документы&lt;br&gt;[SERVICE ACCOUNT][mTLS][IDEMPOTENCY]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="one_c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="accounting_entry_id, status, error" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="one_c" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="Сверка, корректировки и исключения&lt;br&gt;[RBAC:PAYROLL_ACCOUNTANT][MASKING]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="accountant"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="Расчётный лист и статус выплаты&lt;br&gt;[EMPLOYEE-ONLY ACCESS][TLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="employee"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1180" y="520"/><mxPoint x="130" y="520"/></Array></mxGeometry></mxCell><mxCell id="e18" value="CREATE/UPDATE_EMPLOYEE&lt;br&gt;user_id, employee_id, purpose" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="CALCULATE_PAYROLL / ADJUSTMENT&lt;br&gt;user_id, payroll_period, employee_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="SEND_PAYMENT / SEND_REPORT / ERROR&lt;br&gt;batch_id, external_id, result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="RECONCILIATION / MANUAL_CORRECTION&lt;br&gt;user_id, object_id, reason" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
