      pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="DFD Secured: приём пациента и ведение медицинской карты" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1350" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Целевой поток: доступ к медицинским данным только связанному врачу, структурированная карта, шифрование, тегирование и полный аудит действий." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1380" height="40" as="geometry"/></mxCell><mxCell id="patient" value="Пациент&lt;br&gt;&lt;span style='font-size:12px'&gt;внешняя сущность&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="170" height="90" as="geometry"/></mxCell><mxCell id="doctor" value="Медицинский специалист&lt;br&gt;&lt;span style='font-size:12px'&gt;внутренний пользователь&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="220" height="90" as="geometry"/></mxCell><mxCell id="p1" value="2.1&lt;br&gt;Проверка доступа&lt;br&gt;к записи и пациенту" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="220" width="180" height="180" as="geometry"/></mxCell><mxCell id="p2" value="2.2&lt;br&gt;Проведение приёма&lt;br&gt;и ввод медданных" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="220" width="190" height="190" as="geometry"/></mxCell><mxCell id="p3" value="2.3&lt;br&gt;Формирование заключения&lt;br&gt;и назначений" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="220" width="190" height="190" as="geometry"/></mxCell><mxCell id="p4" value="2.4&lt;br&gt;Подписание и сохранение&lt;br&gt;медицинской записи" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1300" y="220" width="190" height="190" as="geometry"/></mxCell><mxCell id="boundary" value="Контур медицинской информационной системы" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;strokeWidth=2;fontSize=13;verticalAlign=bottom;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="280" y="560" width="1220" height="310" as="geometry"/></mxCell><mxCell id="d1" value="D1 IAM / Policy Engine&lt;br&gt;&lt;span style='font-size:11px'&gt;роль, branch_id, purpose&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="630" width="190" height="90" as="geometry"/></mxCell><mxCell id="d2" value="D2 База записей&lt;br&gt;&lt;span style='font-size:11px'&gt;doctor_id, patient_id, status&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="630" width="190" height="90" as="geometry"/></mxCell><mxCell id="d3" value="D3 Электронная медкарта&lt;br&gt;&lt;span style='font-size:11px'&gt;структурированные медданные&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="630" width="220" height="90" as="geometry"/></mxCell><mxCell id="d4" value="D4 Хранилище документов&lt;br&gt;&lt;span style='font-size:11px'&gt;PDF/JPG, версии, checksums&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1070" y="630" width="210" height="90" as="geometry"/></mxCell><mxCell id="d5" value="D5 Audit Log / SIEM&lt;br&gt;&lt;span style='font-size:11px'&gt;READ/WRITE/EXPORT/DENY&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1330" y="630" width="190" height="90" as="geometry"/></mxCell><mxCell id="controls" value="&lt;b&gt;Обязательные меры&lt;/b&gt;&lt;br&gt;• ABAC: doctor_id + patient_id + branch_id + purpose;&lt;br&gt;• запрет доступа при отсутствии текущего/завершённого приёма;&lt;br&gt;• шифрование полей диагноза и результатов;&lt;br&gt;• электронная подпись и версионирование заключений;&lt;br&gt;• маскирование данных вне медицинского контекста;&lt;br&gt;• запрет несанкционированной выгрузки;&lt;br&gt;• immutable audit log и алерты при массовом чтении;&lt;br&gt;• retention и контролируемое удаление документов." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="330" height="250" as="geometry"/></mxCell><mxCell id="e1" value="OIDC + MFA&lt;br&gt;[TLS 1.3]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="doctor" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="Проверка роли DOCTOR,&lt;br&gt;branch_id и purpose=TREATMENT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="Проверка связи doctor_id ↔ patient_id&lt;br&gt;и статуса приёма" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="Разрешённый контекст доступа&lt;br&gt;[ABAC][AUDIT.READ]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="[RESTRICTED][SENSITIVE.HEALTH]&lt;br&gt;Жалобы, анамнез, симптомы&lt;br&gt;[TLS][DATA MINIMIZATION]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="patient" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="[RESTRICTED]&lt;br&gt;Предыдущие диагнозы, назначения,&lt;br&gt;результаты анализов [DECRYPT ON ACCESS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="[RESTRICTED]&lt;br&gt;Результаты осмотра, диагноз,&lt;br&gt;назначения и рекомендации" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="Структурированное заключение&lt;br&gt;[VALIDATION][SIGNATURE]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="[RESTRICTED][SENSITIVE.HEALTH]&lt;br&gt;Версионированная запись&lt;br&gt;[FIELD ENCRYPTION][AUDIT.WRITE]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="Подписанные документы и вложения&lt;br&gt;[ENCRYPT][CHECKSUM][RETENTION]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="Статус приёма и ссылка на заключение&lt;br&gt;[CONFIDENTIAL][AUDIT.WRITE]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="Заключение и назначения&lt;br&gt;[PATIENT-ONLY ACCESS][TLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="patient"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1510" y="470"/><mxPoint x="120" y="470"/></Array></mxGeometry></mxCell><mxCell id="e13" value="ACCESS_GRANTED / ACCESS_DENIED&lt;br&gt;user_id, patient_id, purpose" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="d5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="READ_MEDICAL_RECORD&lt;br&gt;user_id, record_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="d5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="CREATE/UPDATE/SIGN_RECORD&lt;br&gt;version, object_id, checksum" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="d5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
