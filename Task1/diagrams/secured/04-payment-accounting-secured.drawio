        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="DFD Secured: приём оплаты и бухгалтерский учёт" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Целевой поток: единый платёжный сервис, отсутствие карточных реквизитов в системах компании, идемпотентность, автоматическая фискализация и сверка с 1С." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1400" height="40" as="geometry"/></mxCell><mxCell id="patient" value="Пациент&lt;br&gt;&lt;span style='font-size:12px'&gt;внешняя сущность&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="170" height="90" as="geometry"/></mxCell><mxCell id="cashier" value="Кассир&lt;br&gt;&lt;span style='font-size:12px'&gt;внутренний пользователь&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="180" height="90" as="geometry"/></mxCell><mxCell id="provider" value="Платёжный провайдер&lt;br&gt;&lt;span style='font-size:12px'&gt;внешняя система&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1460" y="220" width="220" height="100" as="geometry"/></mxCell><mxCell id="tax_operator" value="ОФД / ККМ&lt;br&gt;&lt;span style='font-size:12px'&gt;фискальная система&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1460" y="430" width="200" height="100" as="geometry"/></mxCell><mxCell id="bookkeeper" value="Бухгалтер&lt;br&gt;&lt;span style='font-size:12px'&gt;внутренний пользователь&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1460" y="650" width="190" height="90" as="geometry"/></mxCell><mxCell id="p1" value="4.1&lt;br&gt;Создание платежа&lt;br&gt;по услуге" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="250" width="180" height="180" as="geometry"/></mxCell><mxCell id="p2" value="4.2&lt;br&gt;Проведение платежа&lt;br&gt;через провайдера" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="240" width="190" height="190" as="geometry"/></mxCell><mxCell id="p3" value="4.3&lt;br&gt;Фискализация&lt;br&gt;и выпуск чека" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="360" width="180" height="180" as="geometry"/></mxCell><mxCell id="p4" value="4.4&lt;br&gt;Сверка и передача&lt;br&gt;в бухгалтерию" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1260" y="580" width="190" height="190" as="geometry"/></mxCell><mxCell id="boundary" value="Контур платёжной системы «Медикаменте»" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;strokeWidth=2;fontSize=13;verticalAlign=bottom;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="270" y="610" width="950" height="300" as="geometry"/></mxCell><mxCell id="d1" value="D1 Payment DB&lt;br&gt;&lt;span style='font-size:11px'&gt;payment_id, amount, status&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="690" width="190" height="90" as="geometry"/></mxCell><mxCell id="d2" value="D2 Receipt Registry&lt;br&gt;&lt;span style='font-size:11px'&gt;чек, fiscal_id, status&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="690" width="190" height="90" as="geometry"/></mxCell><mxCell id="d3" value="D3 Integration Queue&lt;br&gt;&lt;span style='font-size:11px'&gt;outbox, retry, idempotency&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="690" width="190" height="90" as="geometry"/></mxCell><mxCell id="d4" value="D4 Audit Log / SIEM&lt;br&gt;&lt;span style='font-size:11px'&gt;CREATE/PAY/REFUND/EXPORT&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="690" width="190" height="90" as="geometry"/></mxCell><mxCell id="one_c" value="1С:Бухгалтерия предприятия&lt;br&gt;&lt;span style='font-size:11px'&gt;ограниченный интеграционный контур&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1260" y="810" width="230" height="100" as="geometry"/></mxCell><mxCell id="controls" value="&lt;b&gt;Обязательные меры&lt;/b&gt;&lt;br&gt;• карточные реквизиты не хранятся в системах компании;&lt;br&gt;• токенизация у платёжного провайдера;&lt;br&gt;• TLS 1.3, mTLS и OAuth 2.0 между сервисами;&lt;br&gt;• idempotency-key для оплаты, чека и возврата;&lt;br&gt;• RBAC и разделение обязанностей кассира/бухгалтера;&lt;br&gt;• шифрование платёжных данных и чеков;&lt;br&gt;• outbox/retry и автоматическая сверка;&lt;br&gt;• аудит возвратов, корректировок и выгрузок;&lt;br&gt;• запрет ручного Excel-учёта как источника истины." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="350" height="260" as="geometry"/></mxCell><mxCell id="e1" value="[CONFIDENTIAL]&lt;br&gt;appointment_id / service_id&lt;br&gt;[TLS][PATIENT_ID CHECK]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="patient" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="Создание оплаты оператором&lt;br&gt;[RBAC:CASHIER][MFA]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cashier" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="payment_id, patient_id, service_id,&lt;br&gt;amount, status=CREATED&lt;br&gt;[ENCRYPT][AUDIT.WRITE]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="payment_id, amount, return_url&lt;br&gt;[IDEMPOTENCY-KEY]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="Создание платежной сессии&lt;br&gt;[TLS][OAuth2/mTLS][NO CARD DATA]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="provider"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="payment_token, status, provider_payment_id&lt;br&gt;[SIGNED WEBHOOK][REPLAY PROTECTION]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="provider" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="Обновление статуса оплаты&lt;br&gt;[OPTIMISTIC LOCK][AUDIT.WRITE]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="PAID event&lt;br&gt;[OUTBOX][IDEMPOTENT CONSUMER]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="Фискальные данные без лишних ПДн&lt;br&gt;[mTLS][SCHEMA VALIDATION]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="tax_operator"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="fiscal_id, receipt_url, fiscal_status&lt;br&gt;[SIGNED RESPONSE]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tax_operator" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="[CONFIDENTIAL]&lt;br&gt;Чек и фискальный статус&lt;br&gt;[ENCRYPT][RETENTION][CHECKSUM]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="Электронный чек&lt;br&gt;[PATIENT-ONLY ACCESS][TLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="patient"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="560"/><mxPoint x="130" y="560"/></Array></mxGeometry></mxCell><mxCell id="e13" value="ACCOUNTING_EXPORT event&lt;br&gt;[OUTBOX][RETRY]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="Платёж, чек, услуга, сумма,&lt;br&gt;налоговые атрибуты" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="Проводка и статус обработки&lt;br&gt;[SERVICE ACCOUNT][mTLS][IDEMPOTENCY]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="one_c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="accounting_entry_id, status, error" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="one_c" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="Сверка, исключения и отчётность&lt;br&gt;[RBAC:ACCOUNTANT][MASKING]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="bookkeeper"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="CREATE_PAYMENT&lt;br&gt;user_id, payment_id, purpose" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="PAYMENT_SUCCESS / FAILED / REFUND&lt;br&gt;payment_id, provider_id, result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="ACCOUNTING_EXPORT / RECONCILIATION_ERROR&lt;br&gt;payment_id, entry_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
