  <diagram id="177a3c6dcbfd431b83f8" name="05 Inventory Secured">
    <mxGraphModel dx="1850" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1"
      connect="1" arrows="1" fold="1" page="1" pageScale="1"
      pageWidth="1850" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="DFD Secured: учёт ТМЦ и закупок" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Целевой поток: централизованный складской учёт, контролируемая интеграция с 1С, разделение обязанностей, шифрование и аудит всех движений ТМЦ." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1380" height="40" as="geometry"/></mxCell><mxCell id="warehouse" value="Сотрудник склада&lt;br&gt;&lt;span style='font-size:12px'&gt;внутренний пользователь&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="210" height="90" as="geometry"/></mxCell><mxCell id="supplier" value="Поставщик&lt;br&gt;&lt;span style='font-size:12px'&gt;внешняя сущность&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="180" height="90" as="geometry"/></mxCell><mxCell id="bookkeeper" value="Бухгалтер&lt;br&gt;&lt;span style='font-size:12px'&gt;внутренний пользователь&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1450" y="620" width="190" height="90" as="geometry"/></mxCell><mxCell id="p1" value="5.1&lt;br&gt;Приёмка и регистрация&lt;br&gt;поступления ТМЦ" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="230" width="190" height="190" as="geometry"/></mxCell><mxCell id="p2" value="5.2&lt;br&gt;Учёт остатков,&lt;br&gt;списаний и перемещений" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="230" width="190" height="190" as="geometry"/></mxCell><mxCell id="p3" value="5.3&lt;br&gt;Контроль и согласование&lt;br&gt;операций" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="230" width="190" height="190" as="geometry"/></mxCell><mxCell id="p4" value="5.4&lt;br&gt;Интеграция&lt;br&gt;с бухгалтерией" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1260" y="500" width="190" height="190" as="geometry"/></mxCell><mxCell id="boundary" value="Контур складской информационной системы" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;strokeWidth=2;fontSize=13;verticalAlign=bottom;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="270" y="580" width="930" height="310" as="geometry"/></mxCell><mxCell id="d1" value="D1 Inventory DB&lt;br&gt;&lt;span style='font-size:11px'&gt;остатки, партии, движения&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="660" width="190" height="90" as="geometry"/></mxCell><mxCell id="d2" value="D2 Document Storage&lt;br&gt;&lt;span style='font-size:11px'&gt;накладные, акты, версии&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="660" width="190" height="90" as="geometry"/></mxCell><mxCell id="d3" value="D3 Integration Queue&lt;br&gt;&lt;span style='font-size:11px'&gt;outbox, retry, idempotency&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="660" width="190" height="90" as="geometry"/></mxCell><mxCell id="d4" value="D4 Audit Log / SIEM&lt;br&gt;&lt;span style='font-size:11px'&gt;RECEIVE/MOVE/WRITE_OFF/EXPORT&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="660" width="190" height="90" as="geometry"/></mxCell><mxCell id="one_c" value="1С:Бухгалтерия предприятия&lt;br&gt;&lt;span style='font-size:11px'&gt;интеграционный контур&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1260" y="790" width="230" height="100" as="geometry"/></mxCell><mxCell id="controls" value="&lt;b&gt;Обязательные меры&lt;/b&gt;&lt;br&gt;• RBAC: WAREHOUSE, APPROVER, ACCOUNTANT;&lt;br&gt;• разделение приёмки, списания и согласования;&lt;br&gt;• шифрование реквизитов поставщика и документов;&lt;br&gt;• электронная подпись и контроль версий накладных;&lt;br&gt;• idempotency-key и outbox при передаче в 1С;&lt;br&gt;• optimistic locking для остатков;&lt;br&gt;• неизменяемый аудит движений и корректировок;&lt;br&gt;• алерты на массовые списания и отрицательные остатки;&lt;br&gt;• резервное копирование и проверка восстановления." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="350" height="260" as="geometry"/></mxCell><mxCell id="e1" value="[CONFIDENTIAL]&lt;br&gt;Накладная, реквизиты поставщика,&lt;br&gt;номенклатура, количество, стоимость&lt;br&gt;[TLS][DATA MINIMIZATION]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="supplier" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="Подтверждение приёмки&lt;br&gt;[RBAC:WAREHOUSE][MFA]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="warehouse" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="receipt_id, item_id, batch_id,&lt;br&gt;quantity, warehouse_id&lt;br&gt;[ENCRYPT][AUDIT.WRITE]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="Накладная и акт приёмки&lt;br&gt;[VERSIONING][SIGNATURE][CHECKSUM][RETENTION]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="Списание, перемещение,&lt;br&gt;инвентаризация&lt;br&gt;[RBAC:WAREHOUSE]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="warehouse" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="Текущие остатки и партии&lt;br&gt;[AUDIT.READ]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="Изменение движения ТМЦ&lt;br&gt;[OPTIMISTIC LOCK][NO NEGATIVE STOCK][AUDIT.WRITE]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="Операция, требующая согласования&lt;br&gt;[WRITE_OFF / ADJUSTMENT]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="APPROVED / REJECTED&lt;br&gt;[SEPARATION OF DUTIES]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="ACCOUNTING_EXPORT event&lt;br&gt;[OUTBOX][IDEMPOTENCY-KEY]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="Поступление, списание, стоимость,&lt;br&gt;документ и статус" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="Бухгалтерский документ&lt;br&gt;[SERVICE ACCOUNT][mTLS][SCHEMA VALIDATION]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="one_c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="accounting_document_id, status, error" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="one_c" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="Сверка и обработка исключений&lt;br&gt;[RBAC:ACCOUNTANT][MASKING]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="bookkeeper"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="RECEIVE_GOODS&lt;br&gt;user_id, receipt_id, supplier_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="MOVE / WRITE_OFF / INVENTORY&lt;br&gt;user_id, item_id, quantity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="APPROVE / REJECT&lt;br&gt;approver_id, operation_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="ACCOUNTING_EXPORT / SYNC_ERROR&lt;br&gt;operation_id, document_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
