  <diagram id="7ebec0ca44844e59ac23" name="01 Patient registration Secured">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1"
      connect="1" arrows="1" fold="1" page="1" pageScale="1"
      pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="DFD Secured: регистрация пациента и запись на приём" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1280" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Целевой поток: минимизация данных, централизованное хранение, RBAC/ABAC, шифрование, тегирование и неизменяемый аудит." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1350" height="40" as="geometry"/></mxCell><mxCell id="patient" value="Пациент&lt;br&gt;&lt;span style='font-size:12px'&gt;внешняя сущность&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="170" height="90" as="geometry"/></mxCell><mxCell id="reception" value="Сотрудник ресепшена&lt;br&gt;&lt;span style='font-size:12px'&gt;внутренний пользователь&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="210" height="90" as="geometry"/></mxCell><mxCell id="doctor" value="Медицинский специалист&lt;br&gt;&lt;span style='font-size:12px'&gt;внутренний пользователь&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1390" y="310" width="210" height="90" as="geometry"/></mxCell><mxCell id="p1" value="1.1&lt;br&gt;Аутентификация&lt;br&gt;и авторизация" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="260" width="170" height="170" as="geometry"/></mxCell><mxCell id="p2" value="1.2&lt;br&gt;Сбор минимально&lt;br&gt;необходимых данных" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="250" width="180" height="180" as="geometry"/></mxCell><mxCell id="p3" value="1.3&lt;br&gt;Регистрация пациента&lt;br&gt;и согласия" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="250" width="180" height="180" as="geometry"/></mxCell><mxCell id="p4" value="1.4&lt;br&gt;Создание записи&lt;br&gt;на приём" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="250" width="180" height="180" as="geometry"/></mxCell><mxCell id="boundary" value="Контур медицинской информационной системы" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;strokeWidth=2;fontSize=13;verticalAlign=bottom;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="260" y="560" width="1120" height="300" as="geometry"/></mxCell><mxCell id="d1" value="D1 IAM / IdP&lt;br&gt;&lt;span style='font-size:11px'&gt;учётные записи, роли, MFA&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="630" width="190" height="90" as="geometry"/></mxCell><mxCell id="d2" value="D2 Реестр пациентов / CRM&lt;br&gt;&lt;span style='font-size:11px'&gt;PII, контакты, patient_id&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="630" width="210" height="90" as="geometry"/></mxCell><mxCell id="d3" value="D3 Реестр согласий&lt;br&gt;&lt;span style='font-size:11px'&gt;цель, основание, срок&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="630" width="190" height="90" as="geometry"/></mxCell><mxCell id="d4" value="D4 База записей&lt;br&gt;&lt;span style='font-size:11px'&gt;врач, услуга, дата, статус&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="630" width="190" height="90" as="geometry"/></mxCell><mxCell id="d5" value="D5 Audit Log / SIEM&lt;br&gt;&lt;span style='font-size:11px'&gt;неизменяемый журнал&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1280" y="630" width="190" height="90" as="geometry"/></mxCell><mxCell id="controls" value="&lt;b&gt;Обязательные меры&lt;/b&gt;&lt;br&gt;• TLS 1.3 для внешнего и внутреннего трафика;&lt;br&gt;• MFA для сотрудников, OAuth 2.0/OIDC для порталов;&lt;br&gt;• RBAC для ресепшена, ABAC по филиалу и цели доступа;&lt;br&gt;• шифрование данных и резервных копий;&lt;br&gt;• маскирование контактов в интерфейсе;&lt;br&gt;• теги CLASS.CONFIDENTIAL / RESTRICTED;&lt;br&gt;• retention и удаление по политике;&lt;br&gt;• запрет массовой выгрузки и DLP-контроль." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=9;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="350" height="250" as="geometry"/></mxCell><mxCell id="e1" value="OIDC / MFA&lt;br&gt;[TLS 1.3]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="patient" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="Корпоративная учётная запись&lt;br&gt;[MFA][TLS 1.3]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="reception" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="Проверка identity, роли,&lt;br&gt;branch_id и session" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="Авторизованный контекст&lt;br&gt;и разрешённая цель доступа" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="[CONFIDENTIAL][PII.IDENTITY][PII.CONTACT]&lt;br&gt;Только необходимые поля для регистрации&lt;br&gt;[DATA MINIMIZATION][TLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="patient" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="Ввод данных от имени пациента&lt;br&gt;[RBAC: RECEPTION][MASKING]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="reception" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="Валидированные данные + consent&lt;br&gt;[CLASS.CONFIDENTIAL][AUDIT.WRITE]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="patient_id + PII&lt;br&gt;[ENCRYPT AT REST][FIELD ENCRYPTION]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="Согласие: цель, основание, версия, срок&lt;br&gt;[ENCRYPT][RETENTION]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="patient_id + маскированные контакты&lt;br&gt;[RBAC/ABAC][AUDIT.READ]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d2" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="Врач, услуга, дата и время&lt;br&gt;[TLS][RATE LIMIT]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="patient" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="Запись пациента оператором&lt;br&gt;[RBAC][BRANCH_ID]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="reception" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="[CONFIDENTIAL]&lt;br&gt;appointment_id, patient_id, doctor_id,&lt;br&gt;дата, статус [ENCRYPT][AUDIT.WRITE]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="Только записи назначенного врача&lt;br&gt;[ABAC: doctor_id + branch_id][MASKING]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d4" target="doctor"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="AUTH_SUCCESS / AUTH_DENY&lt;br&gt;без секретов и ПДн" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="d5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="CREATE_PATIENT / UPDATE_CONSENT&lt;br&gt;user_id, object_id, purpose" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="d5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="CREATE_APPOINTMENT / CHANGE_STATUS&lt;br&gt;user_id, appointment_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="d5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
