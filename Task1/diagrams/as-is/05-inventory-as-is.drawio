        <mxCell id="title" value="DFD As-Is: учёт ТМЦ и закупок" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Текущее состояние: склад ведёт учёт в файловой базе «1С:Торговля и склад», которая обменивается данными с «1С:Бухгалтерия предприятия»." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1320" height="40" as="geometry"/></mxCell><mxCell id="warehouse" value="Сотрудник склада&lt;br&gt;&lt;span style='font-size:12px'&gt;сотрудник&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="200" height="90" as="geometry"/></mxCell><mxCell id="supplier" value="Поставщик&lt;br&gt;&lt;span style='font-size:12px'&gt;внешняя сущность&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="180" height="90" as="geometry"/></mxCell><mxCell id="bookkeeper" value="Бухгалтер&lt;br&gt;&lt;span style='font-size:12px'&gt;сотрудник&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1340" y="310" width="180" height="90" as="geometry"/></mxCell><mxCell id="p1" value="5.1&lt;br&gt;Регистрация поступления&lt;br&gt;ТМЦ и оборудования" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="240" width="190" height="190" as="geometry"/></mxCell><mxCell id="p2" value="5.2&lt;br&gt;Учёт остатков,&lt;br&gt;списаний и перемещений" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="240" width="190" height="190" as="geometry"/></mxCell><mxCell id="p3" value="5.3&lt;br&gt;Формирование данных&lt;br&gt;для бухгалтерского учёта" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="240" width="190" height="190" as="geometry"/></mxCell><mxCell id="boundary" value="Windows Server 2022 / файловые базы 1С" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;strokeWidth=2;fontSize=13;verticalAlign=bottom;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="410" y="560" width="800" height="280" as="geometry"/></mxCell><mxCell id="d1" value="D1 1С:Торговля и склад&lt;br&gt;&lt;span style='font-size:11px'&gt;файловый режим&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="630" width="230" height="100" as="geometry"/></mxCell><mxCell id="d2" value="D2 1С:Бухгалтерия предприятия&lt;br&gt;&lt;span style='font-size:11px'&gt;файловый режим&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="630" width="250" height="100" as="geometry"/></mxCell><mxCell id="risk" value="&lt;b&gt;Проблемы As-Is&lt;/b&gt;&lt;br&gt;• обе системы работают в файловом режиме;&lt;br&gt;• обмен между 1С не имеет описанного контроля и аудита;&lt;br&gt;• накладные и документы могут содержать данные поставщиков и сотрудников;&lt;br&gt;• возможны расхождения между складским и бухгалтерским учётом;&lt;br&gt;• нет централизованного Data Lineage по движениям ТМЦ;&lt;br&gt;• единый сервер остаётся точкой отказа." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1240" y="560" width="330" height="240" as="geometry"/></mxCell><mxCell id="e1" value="[CONFIDENTIAL]&lt;br&gt;Накладные, реквизиты поставщика,&lt;br&gt;номенклатура, количество, стоимость" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="supplier" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="Подтверждение приёмки&lt;br&gt;и данные ответственного" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="warehouse" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="[INTERNAL / CONFIDENTIAL]&lt;br&gt;Поступление ТМЦ и оборудования" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="Списание, перемещение,&lt;br&gt;инвентаризация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="warehouse" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="[INTERNAL]&lt;br&gt;Изменение остатков&lt;br&gt;и движения ТМЦ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="[INTERNAL]&lt;br&gt;Остатки, карточки номенклатуры,&lt;br&gt;история движений" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="[INTERNAL / CONFIDENTIAL]&lt;br&gt;Поступления, списания,&lt;br&gt;стоимость и документы" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="[CONFIDENTIAL]&lt;br&gt;Бухгалтерские документы&lt;br&gt;и данные по учёту ТМЦ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="Статусы обработки,&lt;br&gt;проводки и корректировки" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="[CONFIDENTIAL]&lt;br&gt;Проводки, закупки,&lt;br&gt;документы и отчёты" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d2" target="bookkeeper"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="Корректировки и обработка&lt;br&gt;бухгалтерских данных" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bookkeeper" target="d2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1450" y="510"/><mxPoint x="950" y="510"/></Array></mxGeometry></mxCell><mxCell id="e12" value="Внутриплатформенный обмен данными&lt;br&gt;[OLE / файловый обмен]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="780"/><mxPoint x="800" y="780"/></Array></mxGeometry></mxCell>
      </root>
