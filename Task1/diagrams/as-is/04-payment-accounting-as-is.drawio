  <diagram id="528fbb0e31644b22af86" name="04 Payment accounting As-Is">
    <mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1"
      connect="1" arrows="1" fold="1" page="1" pageScale="1"
      pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="DFD As-Is: приём оплаты и бухгалтерский учёт" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Текущее состояние: кассир вручную дублирует данные об оплате в Excel и 1С; ККМ передаёт сведения в 1С по TCP/IP и OLE." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1300" height="40" as="geometry"/></mxCell><mxCell id="patient" value="Пациент&lt;br&gt;&lt;span style='font-size:12px'&gt;внешняя сущность&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="170" height="90" as="geometry"/></mxCell><mxCell id="cashier" value="Кассир&lt;br&gt;&lt;span style='font-size:12px'&gt;исполнитель&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="110" width="170" height="90" as="geometry"/></mxCell><mxCell id="bookkeeper" value="Бухгалтер&lt;br&gt;&lt;span style='font-size:12px'&gt;исполнитель&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1320" y="300" width="180" height="90" as="geometry"/></mxCell><mxCell id="p1" value="4.1&lt;br&gt;Расчёт суммы&lt;br&gt;и приём оплаты" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="280" width="180" height="180" as="geometry"/></mxCell><mxCell id="p2" value="4.2&lt;br&gt;Фиксация оплаты&lt;br&gt;в Excel" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="260" width="180" height="180" as="geometry"/></mxCell><mxCell id="p3" value="4.3&lt;br&gt;Регистрация платежа&lt;br&gt;в 1С" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="260" width="180" height="180" as="geometry"/></mxCell><mxCell id="p4" value="4.4&lt;br&gt;Бухгалтерский процессинг&lt;br&gt;и сверка" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1280" y="580" width="190" height="190" as="geometry"/></mxCell><mxCell id="boundary" value="Windows Server 2022 / локальная инфраструктура" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;strokeWidth=2;fontSize=13;verticalAlign=bottom;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="500" y="530" width="720" height="300" as="geometry"/></mxCell><mxCell id="excel" value="D1 Excel&lt;br&gt;&lt;span style='font-size:11px'&gt;ручной платёжный журнал&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="620" width="180" height="90" as="geometry"/></mxCell><mxCell id="kkm" value="ККМ&lt;br&gt;&lt;span style='font-size:11px'&gt;контрольно-кассовая машина&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="620" width="190" height="90" as="geometry"/></mxCell><mxCell id="onec" value="1С:Бухгалтерия предприятия&lt;br&gt;&lt;span style='font-size:11px'&gt;файловый режим&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1030" y="610" width="190" height="100" as="geometry"/></mxCell><mxCell id="risk" value="&lt;b&gt;Проблемы As-Is&lt;/b&gt;&lt;br&gt;• двойной ручной ввод в Excel и 1С;&lt;br&gt;• возможны расхождения суммы, услуги и статуса оплаты;&lt;br&gt;• Excel можно копировать и изменять без полноценного аудита;&lt;br&gt;• файловый режим 1С создаёт риск копирования всей базы;&lt;br&gt;• не определён единый источник истины по платежам;&lt;br&gt;• доступ кассира и бухгалтера не ограничен на уровне отдельных операций;&lt;br&gt;• обмен ККМ и 1С зависит от локального сервера." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="390" height="250" as="geometry"/></mxCell><mxCell id="e1" value="[CONFIDENTIAL]&lt;br&gt;Данные пациента, услуга,&lt;br&gt;способ оплаты" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="patient" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="Ввод суммы и подтверждение оплаты" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cashier" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="Кассовый чек&lt;br&gt;и подтверждение оплаты" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="patient"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="260" y="500"/><mxPoint x="120" y="500"/></Array></mxGeometry></mxCell><mxCell id="e4" value="[CONFIDENTIAL]&lt;br&gt;Сумма, услуга, дата,&lt;br&gt;признак расчёта" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="kkm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="[CONFIDENTIAL]&lt;br&gt;Сведения об оплате" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="[CONFIDENTIAL]&lt;br&gt;Запись в платёжный журнал" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="excel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="[CONFIDENTIAL]&lt;br&gt;Данные платежа для 1С" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="[TCP/IP + OLE]&lt;br&gt;Фискальные данные&lt;br&gt;и сведения о принятии средств" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="kkm" target="onec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="[CONFIDENTIAL]&lt;br&gt;Создание бухгалтерской операции" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="onec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="[CONFIDENTIAL]&lt;br&gt;Данные ручного журнала" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="excel" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="[CONFIDENTIAL]&lt;br&gt;Проводки, чеки, статусы" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="onec" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="Запрос процессинга,&lt;br&gt;сверки и отчётности" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bookkeeper" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="Результаты сверки,&lt;br&gt;отчёты и расхождения" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="bookkeeper"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1480" y="820"/><mxPoint x="1410" y="820"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
