  <diagram id="0abf8c2bcd174469a14b" name="06 HR Payroll As-Is">
    <mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1"
      connect="1" arrows="1" fold="1" page="1" pageScale="1"
      pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="DFD As-Is: кадровый учёт, зарплата и налоги" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Текущее состояние: кадровые и расчётные данные обрабатываются бухгалтерией в файловой базе «1С:Бухгалтерия предприятия» и сопутствующих файлах." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1320" height="40" as="geometry"/></mxCell><mxCell id="employee" value="Сотрудник&lt;br&gt;&lt;span style='font-size:12px'&gt;внешняя сущность&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="180" height="90" as="geometry"/></mxCell><mxCell id="bookkeeper" value="Бухгалтер&lt;br&gt;&lt;span style='font-size:12px'&gt;сотрудник&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="280" width="180" height="90" as="geometry"/></mxCell><mxCell id="bank" value="Банк&lt;br&gt;&lt;span style='font-size:12px'&gt;внешняя система&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1350" y="220" width="180" height="90" as="geometry"/></mxCell><mxCell id="tax" value="Налоговые органы&lt;br&gt;&lt;span style='font-size:12px'&gt;внешняя система&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1350" y="430" width="200" height="90" as="geometry"/></mxCell><mxCell id="p1" value="6.1&lt;br&gt;Кадровый учёт&lt;br&gt;и регистрация сотрудника" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="190" width="190" height="190" as="geometry"/></mxCell><mxCell id="p2" value="6.2&lt;br&gt;Расчёт заработной платы,&lt;br&gt;удержаний и начислений" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="190" width="200" height="200" as="geometry"/></mxCell><mxCell id="p3" value="6.3&lt;br&gt;Формирование выплат&lt;br&gt;и отчётности" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1160" y="300" width="190" height="190" as="geometry"/></mxCell><mxCell id="boundary" value="Windows Server 2022 / файловые хранилища" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;strokeWidth=2;fontSize=13;verticalAlign=bottom;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="460" y="590" width="770" height="270" as="geometry"/></mxCell><mxCell id="d1" value="D1 1С:Бухгалтерия предприятия&lt;br&gt;&lt;span style='font-size:11px'&gt;кадры, зарплата, налоги&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="660" width="260" height="100" as="geometry"/></mxCell><mxCell id="d2" value="D2 Кадровые документы&lt;br&gt;&lt;span style='font-size:11px'&gt;PDF/JPG/Excel/сканы&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="850" y="660" width="220" height="100" as="geometry"/></mxCell><mxCell id="risk" value="&lt;b&gt;Проблемы As-Is&lt;/b&gt;&lt;br&gt;• в одной файловой базе сосредоточены кадровые, зарплатные и налоговые данные;&lt;br&gt;• не описано разделение доступа внутри бухгалтерии;&lt;br&gt;• сканы документов могут содержать паспортные данные, подписи и реквизиты счетов;&lt;br&gt;• отсутствует детальный аудит чтения, выгрузки и изменения;&lt;br&gt;• файлы и отчёты можно копировать на рабочие станции и отправлять по почте;&lt;br&gt;• сервер является единой точкой отказа." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="360" height="240" as="geometry"/></mxCell><mxCell id="e1" value="[RESTRICTED]&lt;br&gt;Паспортные данные, адрес, банковские реквизиты,&lt;br&gt;должность, договор и заявления" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="employee" target="bookkeeper"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="[RESTRICTED]&lt;br&gt;Кадровые сведения и документы" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bookkeeper" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="[RESTRICTED]&lt;br&gt;Создание/изменение карточки сотрудника" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="[RESTRICTED]&lt;br&gt;Сохранение договоров, заявлений,&lt;br&gt;паспортных и кадровых документов" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="[RESTRICTED]&lt;br&gt;Должность, оклад, график,&lt;br&gt;льготы, удержания и начисления" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="Табели, премии,&lt;br&gt;корректировки и основания" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bookkeeper" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="[RESTRICTED]&lt;br&gt;Результаты расчёта зарплаты&lt;br&gt;и налоговых обязательств" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="[RESTRICTED]&lt;br&gt;Реестр выплат, налоги,&lt;br&gt;страховые взносы и отчёты" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="[RESTRICTED]&lt;br&gt;Платёжный реестр:&lt;br&gt;сотрудник, счёт, сумма" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="bank"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="[RESTRICTED]&lt;br&gt;Налоговая и кадровая отчётность" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="tax"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="[RESTRICTED]&lt;br&gt;Расчётный лист и сведения о выплате" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="employee"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="520"/><mxPoint x="130" y="520"/></Array></mxGeometry></mxCell>
      </root>
