  <diagram id="929e7f6b276341b39e87" name="02 Medical appointment As-Is">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1"
      connect="1" arrows="1" fold="1" page="1" pageScale="1"
      pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="DFD As-Is: приём пациента и ведение медицинской карты" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Текущее состояние: врач работает с Excel-журналом и файлами пациента на общем файловом сервере; операции чтения и изменения не аудируются." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1280" height="40" as="geometry"/></mxCell><mxCell id="patient" value="Пациент&lt;br&gt;&lt;span style='font-size:12px'&gt;внешняя сущность&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="170" height="90" as="geometry"/></mxCell><mxCell id="doctor" value="Медицинский специалист&lt;br&gt;&lt;span style='font-size:12px'&gt;внешняя сущность&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="210" height="90" as="geometry"/></mxCell><mxCell id="p1" value="2.1&lt;br&gt;Поиск записи&lt;br&gt;и идентификация пациента" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="280" width="170" height="170" as="geometry"/></mxCell><mxCell id="p2" value="2.2&lt;br&gt;Проведение приёма&lt;br&gt;и сбор медицинских сведений" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="270" width="190" height="190" as="geometry"/></mxCell><mxCell id="p3" value="2.3&lt;br&gt;Формирование заключения&lt;br&gt;и обновление карты" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="270" width="190" height="190" as="geometry"/></mxCell><mxCell id="boundary" value="Общий файловый сервер / Windows Server 2022" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;strokeWidth=2;fontSize=13;verticalAlign=bottom;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="460" y="550" width="760" height="290" as="geometry"/></mxCell><mxCell id="d1" value="D1 Journal-Doctor-FIO.xlsx&lt;br&gt;&lt;span style='font-size:11px'&gt;журнал записей врача&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="620" width="200" height="90" as="geometry"/></mxCell><mxCell id="d2" value="D2 Папка пациента&lt;br&gt;&lt;span style='font-size:11px'&gt;PDF/JPG/Excel/сканы&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="620" width="200" height="90" as="geometry"/></mxCell><mxCell id="d3" value="D3 Patients.xlsx&lt;br&gt;&lt;span style='font-size:11px'&gt;идентификационные данные&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1020" y="620" width="180" height="90" as="geometry"/></mxCell><mxCell id="risk" value="&lt;b&gt;Проблемы As-Is&lt;/b&gt;&lt;br&gt;• медицинская карта представлена неструктурированными файлами;&lt;br&gt;• доступ не ограничен связью врача с пациентом;&lt;br&gt;• возможны локальные копии и отправка по почте;&lt;br&gt;• нет версии документа и единого источника истины;&lt;br&gt;• отсутствуют аудит чтения, изменения и удаления;&lt;br&gt;• в журналах могут храниться избыточные медицинские сведения." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="360" height="230" as="geometry"/></mxCell><mxCell id="e1" value="Запрос списка приёмов&lt;br&gt;и данных пациента" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="doctor" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="[CONFIDENTIAL]&lt;br&gt;Дата, время, пациент, услуга" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="[CONFIDENTIAL]&lt;br&gt;Ф. И. О., дата рождения,&lt;br&gt;контактные данные" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="Подтверждённая запись&lt;br&gt;и идентифицированный пациент" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="[RESTRICTED]&lt;br&gt;Жалобы, анамнез, хронические заболевания,&lt;br&gt;предыдущие исследования и документы" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="patient" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="[RESTRICTED]&lt;br&gt;Чтение предыдущих заключений,&lt;br&gt;анализов и медицинских документов" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d2" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="[RESTRICTED]&lt;br&gt;Результаты осмотра, диагноз,&lt;br&gt;назначения и рекомендации" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="[RESTRICTED]&lt;br&gt;Сохранение заключения и файлов&lt;br&gt;в папку пациента" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="[CONFIDENTIAL]&lt;br&gt;Изменение статуса приёма&lt;br&gt;и добавление заметки" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="Заключение, назначения&lt;br&gt;и рекомендации" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="patient"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1220" y="500"/><mxPoint x="120" y="500"/></Array></mxGeometry></mxCell>
      </root>
