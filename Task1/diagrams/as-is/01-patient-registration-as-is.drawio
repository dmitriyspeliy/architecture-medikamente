  <diagram id="03a5cb8bfd854575bb27" name="01 Patient registration As-Is">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1"
      connect="1" arrows="1" fold="1" page="1" pageScale="1"
      pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="DFD As-Is: регистрация пациента и запись на приём" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Текущее состояние: ручной ввод, Excel/PDF/JPG на общем файловом сервере, без аудита действий и классификации данных." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1250" height="40" as="geometry"/></mxCell><mxCell id="patient" value="Пациент&lt;br&gt;&lt;span style='font-size:12px'&gt;внешняя сущность&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="170" height="90" as="geometry"/></mxCell><mxCell id="doctor" value="Медицинский специалист&lt;br&gt;&lt;span style='font-size:12px'&gt;внешняя сущность&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1320" y="310" width="210" height="90" as="geometry"/></mxCell><mxCell id="p1" value="1.1&lt;br&gt;Сбор данных пациента&lt;br&gt;&lt;span style='font-size:11px'&gt;исполнитель: ресепшен&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="270" width="170" height="170" as="geometry"/></mxCell><mxCell id="p2" value="1.2&lt;br&gt;Регистрация пациента&lt;br&gt;и оформление договора&lt;br&gt;&lt;span style='font-size:11px'&gt;исполнитель: ресепшен&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="270" width="190" height="190" as="geometry"/></mxCell><mxCell id="p3" value="1.3&lt;br&gt;Запись на приём&lt;br&gt;&lt;span style='font-size:11px'&gt;исполнитель: ресепшен&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="280" width="170" height="170" as="geometry"/></mxCell><mxCell id="boundary" value="Общий файловый сервер / Windows Server 2022" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;strokeWidth=2;fontSize=13;verticalAlign=bottom;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="500" y="530" width="690" height="300" as="geometry"/></mxCell><mxCell id="d1" value="D1 Patients.xlsx&lt;br&gt;&lt;span style='font-size:11px'&gt;список пациентов&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="600" width="180" height="90" as="geometry"/></mxCell><mxCell id="d2" value="D2 Договоры и анкеты&lt;br&gt;&lt;span style='font-size:11px'&gt;PDF/JPG/сканы&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="600" width="190" height="90" as="geometry"/></mxCell><mxCell id="d3" value="D3 Journal-Doctor-FIO.xlsx&lt;br&gt;&lt;span style='font-size:11px'&gt;журнал записи врача&lt;/span&gt;" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="600" width="180" height="90" as="geometry"/></mxCell><mxCell id="risk" value="&lt;b&gt;Проблемы As-Is&lt;/b&gt;&lt;br&gt;• данные вводятся и исправляются вручную;&lt;br&gt;• файлы можно копировать и отправлять без контроля;&lt;br&gt;• отсутствуют RBAC/ABAC на уровне пациента;&lt;br&gt;• чтение, изменение и выгрузка не аудируются;&lt;br&gt;• нет классификации, тегов, сроков хранения и Data Lineage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="380" height="220" as="geometry"/></mxCell><mxCell id="e1" value="[CONFIDENTIAL / RESTRICTED]&lt;br&gt;Ф. И. О., дата рождения, телефон, email,&lt;br&gt;адрес, место работы/учёбы, хронические заболевания" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="patient" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="Проверенные данные пациента&lt;br&gt;и заполненная анкета" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="[CONFIDENTIAL]&lt;br&gt;Создание/изменение записи пациента" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="[CONFIDENTIAL / RESTRICTED]&lt;br&gt;Договор, согласия, анкета и сканы" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="[CONFIDENTIAL]&lt;br&gt;Поиск и чтение данных пациента" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="Желаемые врач, услуга,&lt;br&gt;дата и время" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="patient" target="p3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="460"/><mxPoint x="850" y="460"/></Array></mxGeometry></mxCell><mxCell id="e7" value="[CONFIDENTIAL]&lt;br&gt;Запись пациента к специалисту" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="[CONFIDENTIAL]&lt;br&gt;Просмотр своего журнала" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3" target="doctor"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="Изменение статуса записи&lt;br&gt;и заметок" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="doctor" target="d3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="450"/><mxPoint x="1260" y="680"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
