  <diagram id="b091ee33186d4bbb9753" name="C4 C2 Data Classification Engine">
    <mxGraphModel dx="1900" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1"
      connect="1" arrows="1" fold="1" page="1" pageScale="1"
      pageWidth="1900" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="C4 Container Diagram (C2) — движок классификации данных" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Batch-классификация перед загрузкой в аналитическое хранилище: schema drift, confidence routing, Privacy by Design и масштабирование." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1500" height="35" as="geometry"/></mxCell><mxCell id="sources" value="&lt;b&gt;Операционные системы&lt;/b&gt;&lt;br&gt;[External Systems]&lt;br&gt;&lt;span style='font-size:11px'&gt;CRM, медицинская система, платежи, лаборатория, 1С, файлы и логи&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="260" height="150" as="geometry"/></mxCell><mxCell id="steward" value="&lt;b&gt;Data Steward&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;span style='font-size:11px'&gt;Проверяет спорные классификации и подтверждает новые правила&lt;/span&gt;" style="html=1;fontSize=12;dashed=0;whiteSpace=wrap;fillColor=#08427b;strokeColor=#052e56;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;resizable=0;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="240" height="180" as="geometry"/></mxCell><mxCell id="analyst" value="&lt;b&gt;Аналитик / BI / ML&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;span style='font-size:11px'&gt;Работает только с разрешёнными наборами Trusted Zone&lt;/span&gt;" style="html=1;fontSize=12;dashed=0;whiteSpace=wrap;fillColor=#08427b;strokeColor=#052e56;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;resizable=0;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="240" height="180" as="geometry"/></mxCell><mxCell id="iamkms" value="&lt;b&gt;IAM / KMS / Vault&lt;/b&gt;&lt;br&gt;[External Platform]&lt;br&gt;&lt;span style='font-size:11px'&gt;Service identity, ключи, секреты, mTLS и short-lived credentials&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1580" y="900" width="260" height="160" as="geometry"/></mxCell><mxCell id="boundary" value="DATA CLASSIFICATION &amp; ANALYTICS PLATFORM" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#555555;strokeWidth=2;fontSize=15;verticalAlign=bottom;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="330" y="120" width="1190" height="1040" as="geometry"/></mxCell><mxCell id="orchestrator" value="&lt;b&gt;Batch Orchestrator&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;&lt;span style='font-size:11px'&gt;Airflow / Argo Workflows&lt;br&gt;Запуск batch, retry, checkpoint и SLA&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#2f6ea6;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="380" y="180" width="250" height="130" as="geometry"/></mxCell><mxCell id="landing" value="&lt;b&gt;Landing Zone&lt;/b&gt;&lt;br&gt;[Container: Object Storage]&lt;br&gt;&lt;span style='font-size:11px'&gt;Исходные encrypted batch, immutable ingest, checksum, короткий TTL&lt;/span&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="180" width="250" height="130" as="geometry"/></mxCell><mxCell id="schema_detector" value="&lt;b&gt;Schema Detector&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;&lt;span style='font-size:11px'&gt;Типы, поля, вложенность, кардинальность, профили значений&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#2f6ea6;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1020" y="180" width="250" height="130" as="geometry"/></mxCell><mxCell id="schema_registry" value="&lt;b&gt;Schema Registry&lt;/b&gt;&lt;br&gt;[Container: Metadata Store]&lt;br&gt;&lt;span style='font-size:11px'&gt;Версии схем, совместимость, owner и история изменений&lt;/span&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1320" y="180" width="160" height="130" as="geometry"/></mxCell><mxCell id="drift" value="&lt;b&gt;Schema Drift Detector&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;&lt;span style='font-size:11px'&gt;Новые/удалённые поля, изменение типов, privacy-sensitive drift&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#2f6ea6;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="380" y="390" width="250" height="140" as="geometry"/></mxCell><mxCell id="classifier" value="&lt;b&gt;Classification Engine&lt;/b&gt;&lt;br&gt;[Container]&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Rules + profiling + context + ML; class, semantic tag и confidence score&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#2f6ea6;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="390" width="250" height="140" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;Privacy Rules Service&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;&lt;span style='font-size:11px'&gt;Версии правил, allowed zones, masking, retention и purpose&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#2f6ea6;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1020" y="390" width="250" height="140" as="geometry"/></mxCell><mxCell id="metadata" value="&lt;b&gt;Metadata Catalog &amp; Lineage&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;&lt;span style='font-size:11px'&gt;OpenMetadata: теги, owner, lineage, rule version и consumers&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#2f6ea6;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1320" y="390" width="160" height="140" as="geometry"/></mxCell><mxCell id="transform" value="&lt;b&gt;Privacy Transformation Service&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;&lt;span style='font-size:11px'&gt;Masking, tokenization, pseudonymization, anonymization и field encryption&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#2f6ea6;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="610" width="300" height="160" as="geometry"/></mxCell><mxCell id="audit" value="&lt;b&gt;Audit &amp; Monitoring&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;&lt;span style='font-size:11px'&gt;Precision, Recall, FNR, coverage, batch duration, backlog, alerts и immutable audit&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#2f6ea6;fontColor=#ffffff;align=center;arcSize=10;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1110" y="620" width="300" height="150" as="geometry"/></mxCell><mxCell id="quarantine" value="&lt;b&gt;Quarantine Zone&lt;/b&gt;&lt;br&gt;[Container: Storage]&lt;br&gt;&lt;span style='font-size:11px'&gt;Unknown schema, low confidence, policy conflicts, manual review&lt;/span&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="380" y="860" width="230" height="150" as="geometry"/></mxCell><mxCell id="restricted" value="&lt;b&gt;Restricted Zone&lt;/b&gt;&lt;br&gt;[Container: Storage]&lt;br&gt;&lt;span style='font-size:11px'&gt;Необходимые конфиденциальные данные, ABAC, per-read audit&lt;/span&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="670" y="860" width="230" height="150" as="geometry"/></mxCell><mxCell id="protected" value="&lt;b&gt;Protected Zone&lt;/b&gt;&lt;br&gt;[Container: Storage]&lt;br&gt;&lt;span style='font-size:11px'&gt;Очищенные, нормализованные и псевдонимизированные данные&lt;/span&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="960" y="860" width="230" height="150" as="geometry"/></mxCell><mxCell id="trusted" value="&lt;b&gt;Trusted Analytics Zone&lt;/b&gt;&lt;br&gt;[Container: Storage]&lt;br&gt;&lt;span style='font-size:11px'&gt;Обезличенные и агрегированные витрины для BI / ML / AI&lt;/span&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1250" y="860" width="230" height="150" as="geometry"/></mxCell><mxCell id="scaling_note" value="&lt;b&gt;Scalability&lt;/b&gt;&lt;br&gt;• stateless classification workers;&lt;br&gt;• partitioning по source/date/dataset;&lt;br&gt;• Object Storage + Spark/Kubernetes Jobs;&lt;br&gt;• autoscaling по backlog и batch duration;&lt;br&gt;• независимое масштабирование ingestion, classification и query layers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1580" y="200" width="260" height="240" as="geometry"/></mxCell><mxCell id="quality_note" value="&lt;b&gt;Fail-closed policy&lt;/b&gt;&lt;br&gt;Новое или нераспознанное поле не может попасть в Trusted Zone. При конфликте выбирается более строгий класс." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1580" y="500" width="260" height="150" as="geometry"/></mxCell><mxCell id="e1" value="Передают batch-файлы и выгрузки" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sources" target="orchestrator"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Записывает immutable batch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="orchestrator" target="landing"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Передаёт файл и metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="landing" target="schema_detector"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Регистрирует inferred schema" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="schema_detector" target="schema_registry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="Предоставляет предыдущую версию" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="schema_registry" target="drift"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="Передаёт новую схему" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="schema_detector" target="drift"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="Передаёт approved/changed fields" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="drift" target="classifier"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="Запрашивает политики и thresholds" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="classifier" target="rules"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="Пишет tags, confidence и lineage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="classifier" target="metadata"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="Передаёт classification result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="classifier" target="transform"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="Передаёт masking/tokenization policy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rules" target="transform"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="Low confidence / conflict / unknown" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="classifier" target="quarantine"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="Проверяет и подтверждает" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="steward" target="quarantine"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="Создаёт/уточняет правила" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="steward" target="rules"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="Сохраняет необходимые PII/PHI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="transform" target="restricted"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="Сохраняет pseudonymized data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="transform" target="protected"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="Публикует anonymized/aggregated data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="transform" target="trusted"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="Контролируемая трансформация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="restricted" target="protected"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="Quality gate и минимизация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="protected" target="trusted"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="Читает разрешённые витрины" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="analyst" target="trusted"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="Batch metrics и status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="orchestrator" target="audit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="Schema drift events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="drift" target="audit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="Precision/Recall/FNR/Coverage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="classifier" target="audit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="Policy actions и failures" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="transform" target="audit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="Сохраняет operational lineage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="audit" target="metadata"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="Ключи, secrets и service identity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="iamkms" target="transform"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="Encryption keys и access control" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="iamkms" target="restricted"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="Query identity и access policy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="iamkms" target="trusted"><mxGeometry relative="1" as="geometry"/></mxCell>
