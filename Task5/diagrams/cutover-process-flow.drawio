<mxfile host="app.diagrams.net" modified="2026-07-05T09:24:00.000Z" agent="ChatGPT" version="25.0.3">
  <diagram id="547cc694446744da9732" name="Cutover Parallel Run">
    <mxGraphModel dx="1900" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1"
      connect="1" arrows="1" fold="1" page="1" pageScale="1"
      pageWidth="1900" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Cutover-процесс: Parallel Run" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Пошаговое переключение доменов с shadow run, pilot, reconciliation, Go/No-Go и контролируемым rollback." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1350" height="35" as="geometry"/></mxCell><mxCell id="start" value="Старт" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="130" height="70" as="geometry"/></mxCell><mxCell id="plan" value="&lt;b&gt;1. Подготовка&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;scope, роли, SLO, RTO/RPO, change freeze&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="150" width="240" height="120" as="geometry"/></mxCell><mxCell id="data" value="&lt;b&gt;2. Подготовка данных&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;inventory, profiling, patient_id, cleansing&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="150" width="240" height="120" as="geometry"/></mxCell><mxCell id="platform" value="&lt;b&gt;3. Готовность платформы&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;infra, backup, IAM, monitoring, security&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="150" width="240" height="120" as="geometry"/></mxCell><mxCell id="dryrun" value="&lt;b&gt;4. Dry-run&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;полная репетиция миграции и rollback&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1190" y="150" width="240" height="120" as="geometry"/></mxCell><mxCell id="ready1" value="Готовы к&lt;br&gt;shadow run?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1510" y="140" width="170" height="140" as="geometry"/></mxCell><mxCell id="shadow" value="&lt;b&gt;5. Shadow run&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;новая система обрабатывает копии данных без влияния на бизнес&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1510" y="380" width="240" height="130" as="geometry"/></mxCell><mxCell id="recon1" value="&lt;b&gt;6. Reconciliation&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;сверка сущностей, сумм, документов и статусов&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1190" y="390" width="240" height="120" as="geometry"/></mxCell><mxCell id="pilot" value="&lt;b&gt;7. Pilot parallel run&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;ограниченный филиал или группа пользователей&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="390" width="240" height="120" as="geometry"/></mxCell><mxCell id="ready2" value="Пилот&lt;br&gt;успешен?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="380" width="170" height="140" as="geometry"/></mxCell><mxCell id="freeze" value="&lt;b&gt;8. Write freeze&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;остановка legacy-write для выбранного домена&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="390" width="240" height="120" as="geometry"/></mxCell><mxCell id="delta" value="&lt;b&gt;9. Delta migration&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;финальный перенос изменений, checksum и сверка&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="240" height="120" as="geometry"/></mxCell><mxCell id="switch" value="&lt;b&gt;10. Переключение&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;routing, API, callbacks, feature flags&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="240" height="120" as="geometry"/></mxCell><mxCell id="smoke" value="&lt;b&gt;11. Smoke tests&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;критичные пользовательские и интеграционные сценарии&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="650" width="240" height="120" as="geometry"/></mxCell><mxCell id="gonogo" value="Go / No-Go?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="640" width="170" height="140" as="geometry"/></mxCell><mxCell id="hypercare" value="&lt;b&gt;12. Hypercare&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;усиленный мониторинг, incident bridge, daily reconciliation&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="650" width="240" height="120" as="geometry"/></mxCell><mxCell id="stable" value="Система&lt;br&gt;стабильна?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1300" y="640" width="170" height="140" as="geometry"/></mxCell><mxCell id="legacyro" value="&lt;b&gt;13. Legacy read-only&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;запрет новых операций, только проверка и архив&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1560" y="650" width="240" height="120" as="geometry"/></mxCell><mxCell id="decom" value="&lt;b&gt;14. Decommission&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;архивирование, отзыв доступов, вывод инфраструктуры&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1560" y="900" width="240" height="120" as="geometry"/></mxCell><mxCell id="end" value="Миграция&lt;br&gt;завершена" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1260" y="915" width="170" height="90" as="geometry"/></mxCell><mxCell id="rollback" value="&lt;b&gt;Rollback&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;stop write → return routing → enable legacy write → reconcile new operations → RCA&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="900" width="400" height="130" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Ключевой принцип&lt;/b&gt;&lt;br&gt;Для каждого домена в каждый момент времени существует только один master/source of truth. Постоянный двусторонний dual-write не используется." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="500" height="130" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="start" target="plan"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="plan" target="data"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="data" target="platform"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="platform" target="dryrun"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dryrun" target="ready1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ready1" target="shadow"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="shadow" target="recon1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="recon1" target="pilot"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pilot" target="ready2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ready2" target="freeze"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="freeze" target="delta"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="delta" target="switch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="switch" target="smoke"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="smoke" target="gonogo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="GO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gonogo" target="hypercare"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="hypercare" target="stable"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stable" target="legacyro"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="legacyro" target="decom"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="decom" target="end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r1" value="Нет: устранить дефекты" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ready1" target="dryrun"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r2" value="Нет: вернуться в shadow run" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ready2" target="shadow"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r3" value="NO-GO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gonogo" target="rollback"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r4" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stable" target="rollback"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r5" value="После RCA и исправлений" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rollback" target="shadow"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
